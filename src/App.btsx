import { useCrawler, exampleUrl } from './lib/use-crawler'
import FileMetadata from './components/FileMetadata.btsx'

setup const c = useCrawler();

div.app-shell
  header.topbar
    a.brand(href='/' aria-label='Shai Hulud home')
      span.brand-mark(aria-hidden='true') ≋
      span SHAI HULUD
    div.topbar-right
      span.local-dot
      span Local workspace
      span.version v0.1

  main.workspace
    section.page-heading
      div
        p.eyebrow REPOSITORY → COMPONENTS
        h1 Give your code a new form.
        p.subtitle Crawl a public GitHub folder. Convert its TSX. Keep the result.
      div.heading-stamp
        span 01 / EXTRACT
        span 02 / TRANSFORM
        span 03 / SAVE

    if c.error
      div.alert(role='alert') #{c.error}

    div.workbench
      aside.controls
        section.panel.source-panel
          div.section-heading
            span.step 01
            h2 Source repository
          form(onSubmit={(event) => { event.preventDefault(); c.crawl(); }})
            label.field-label(htmlFor='repo-url') GitHub URL
            textarea#repo-url(rows={3} placeholder='https://github.com/owner/repo/tree/main/components' value={c.url} onInput={(event) => c.setUrl(event.currentTarget.value)} disabled={c.busy || c.running} required={true} spellCheck={false})
            div.field-note Public repositories · includes subfolders
            button.primary.scan-button(type='submit' disabled={!c.url.trim() || c.busy || c.running})
              span #{c.busy && !c.running ? 'Working…' : 'Inspect repository'}
              span(aria-hidden='true') ↗
          button.example-button(type='button' disabled={c.busy || c.running} onClick={() => c.setUrl(exampleUrl)}) Try the ReUI example ↗
          if c.source
            div.repo-summary
              strong #{c.source.owner + '/' + c.source.repo}
              code #{c.source.ref + ' · ' + c.source.commit.slice(0, 7)}
              span #{c.source.folder || 'Repository root'}

        section.panel
          div.section-heading
            span.step 02
            h2 Conversion settings
          p.field-label Output format
          div.format-options
            button.format-option(type='button' aria-pressed={c.formats.includes('btsx')} disabled={c.running || c.busy} onClick={() => c.toggleFormat('btsx')})
              span.format-top
                strong BTSX
                span.selection-dot
              code .btsx
              span Beast syntax
            button.format-option(type='button' aria-pressed={c.formats.includes('tsrx')} disabled={c.running || c.busy} onClick={() => c.toggleFormat('tsrx')})
              span.format-top
                strong TSRX
                span.selection-dot
              code .tsrx
              span Octane syntax
          label.check-row
            input(type='checkbox' checked={c.includeTs} onChange={(event) => c.setIncludeTs(event.currentTarget.checked)} disabled={c.running || c.busy})
            span
              strong Include TypeScript files
              small Copy .ts files without conversion
          div.converter-note
            span(className={c.config?.converterConfigured ? 'status-dot connected' : 'status-dot'})
            span #{c.config?.converterConfigured ? 'Converter configured' : 'Connecting to local server…'}
          if c.config?.converterUrl
            code.endpoint(title={c.config.converterUrl}) #{c.config.converterUrl}
          button.primary.convert-button(type='button' onClick={() => c.convert()} disabled={!c.scan || c.busy || c.running || !c.config?.converterConfigured || !c.formats.length || !c.selectedCount})
            span #{c.running ? 'Conversion in progress…' : c.scan ? `Convert ${c.selectedCount} selected & save` : 'Convert & save locally'}
            span(aria-hidden='true') →

        div.storage-note
          span.storage-icon(aria-hidden='true') ↓
          div
            strong Your files stay in your workspace.
            p Outputs preserve the folder structure. Each run gets its own directory and manifest.

      section.results
        section.panel.files-panel
          div.files-heading
            div.section-heading
              span.step 03
              h2 #{c.job ? 'Conversion run' : 'Repository files'}
            span.count-badge #{c.job ? c.job.files.length + ' outputs' : c.scan ? c.scan.files.length + ' files' : 'Awaiting source'}
          if c.scan || c.job
            fragment
              div.stats-bar
                if c.job
                  fragment
                    span
                      strong #{c.saved}
                      |  saved
                    span
                      strong #{c.failed}
                      |  failed
                    span.run-status(role='status') #{c.job.status}
                else
                  fragment
                    span
                      strong #{c.tsxCount}
                      |  TSX to convert
                    span
                      strong #{c.tsCount}
                      |  TypeScript files
                    span Ready to convert
              if c.job
                div.progress-track(role='progressbar' aria-label='Conversion progress' aria-valuenow={c.finished} aria-valuemin={0} aria-valuemax={c.job.files.length})
                  div.progress-fill(style={{ width: `${c.finished / c.job.files.length * 100}%` }})
              div.file-toolbar
                input.file-search(type='search' placeholder='Filter files…' aria-label='Filter files' value={c.filter} onInput={(event) => c.setFilter(event.currentTarget.value)})
                if c.running
                  button.text-button(type='button' onClick={() => c.cancel()}) Cancel run
                else
                  if c.job && (c.failed || c.job.status === 'cancelled')
                    button.text-button(type='button' disabled={c.busy} onClick={() => c.retry()}) Retry unfinished files
                  else
                    span #{c.job ? 'Select a saved file to preview' : 'Recursive folder scan'}
                if c.job && c.scan && !c.running
                  button.text-button(type='button' disabled={c.busy} onClick={() => c.chooseFiles()}) Change file selection
              if !c.job
                div.file-selection-bar
                  label.select-all
                    input(type='checkbox' ref={c.selectAllRef} checked={c.allSelected} disabled={c.busy || !c.eligibleCount} onChange={() => c.toggleAll()})
                    span Select all files
                  span #{`${c.selectedCount} of ${c.eligibleCount} selected`}
              div.file-list
                each file in c.rows key file.output
                  if c.job
                    button.file-row.converted-file(type='button' disabled={file.status !== 'saved'} onClick={() => c.setOutputPath(file.output)} aria-pressed={c.outputPath === file.output} title={file.error || file.path})
                      span.file-icon #{file.kind === 'tsx' ? 'TX' : 'TS'}
                      span.file-info
                        span.file-name #{file.path}
                        if file.error || ('warning' in file && file.warning)
                          span.file-error #{file.error || ('warning' in file ? file.warning : '')}
                        else
                          span.file-detail #{file.kind === 'ts' ? '.ts copied · ' + file.format + ' folder' : '→ .' + file.format}
                        if file.kind === 'tsx' && (file.status === 'saved' || file.status === 'failed')
                          FileMetadata(metadata={file.metadata})
                        if file.kind === 'ts' && file.status === 'saved'
                          span.file-detail Copied unchanged · compilation not run
                      span(className={'file-status status-' + file.status}) #{file.status}
                  else
                    label.file-row.selectable-file
                      input(type='checkbox' aria-label={`Select ${file.path}`} checked={c.selectedPaths.has(file.path) && (c.includeTs || file.kind === 'tsx')} disabled={c.busy || (!c.includeTs && file.kind === 'ts')} onChange={() => c.toggleFile(file.path)})
                      span.file-icon #{file.kind === 'tsx' ? 'TX' : 'TS'}
                      span.file-info
                        span.file-name #{file.path}
                        span.file-detail #{file.kind === 'tsx' ? 'Ready for conversion' : c.includeTs ? 'Copy unchanged when selected' : 'Enable “Include TypeScript files” to select'}
                if !c.rows.length
                  p.no-files #{c.filter ? 'No files match your filter.' : 'No .tsx or .ts files found in this folder.'}
          else
            div.empty-state
              div.empty-illustration(aria-hidden='true')
                div.orbit.orbit-one
                div.orbit.orbit-two
                div.code-tile &lt;/&gt;
                span.mini-tile.tile-left .tsx
                span.mini-tile.tile-right .btsx
              h3 A new home for your components.
              p Paste a repository or folder link to discover its TypeScript files and prepare your first conversion.
              div.empty-tags
                span Public GitHub repos
                span Nested folders
                span Two output formats
          if c.job
            fragment
              div.output-location
                div
                  strong #{c.running ? 'Saving to' : 'Output directory'}
                  code #{c.job.outputDir}
                a.text-button(href={`/api/jobs/${c.job.id}/manifest`} download='manifest.json') Manifest ↓
              if c.job.error
                p.job-error(role='alert') #{c.job.error}

        section.preview-panel
          div.preview-header
            div
              span.terminal-dots(aria-hidden='true') ● ● ●
              span #{c.preview?.path || 'Output preview'}
            if c.preview
              div.preview-actions
                button(type='button' onClick={() => c.copyCode()}) #{c.copied ? 'Copied' : 'Copy'}
                a(href={`/api/jobs/${c.job?.id}/output?path=${encodeURIComponent(c.preview.path)}&download=1`}) Download ↓
          if c.previewLoading
            p.preview-placeholder Loading saved file…
          else
            fragment
              if c.previewError
                p.preview-placeholder(role='alert') #{c.previewError}
              else
                fragment
                  if c.preview
                    pre.code-preview
                      code #{c.preview.code}
                  else
                    div.preview-empty
                      code // Your next component starts here.
                      p Converted code will be available to inspect as each file is saved.

    footer.page-footer
      span SHAI HULUD
      span Built for moving code forward.
      span .tsx → .btsx / .tsrx
