import { useCrawler } from './lib/use-crawler'
import Icon from './components/Icon.btsx'
import Ring from './components/Ring.btsx'
import TrayHeader from './TrayHeader.btsx'
import Column, { formatNames } from './Column.btsx'
import FileList from './FileList.btsx'
import TrayFooter, { jobTone } from './TrayFooter.btsx'

module
  type Crawler = ReturnType<typeof useCrawler>
  type ConverterState = {
    tone: string
    label: string
  }

  const host = (url: string) => { try { return new URL(url).host; } catch { return url; } };
  const started = (iso: string) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

  // The headline card: a ring, a score-like figure, a status pill and four tiles.
  function overview(c: Crawler) {
    if (c.job) {
      const total = c.job.files.length;
      const done = total ? c.finished / total : 0;
      return {
        eyebrow: 'Conversion run', value: String(c.saved), total: `/ ${total}`, ring: done, ringLabel: `${Math.round(done * 100)}%`,
        tone: jobTone[c.job.status], pill: c.job.status, caption: `Started ${started(c.job.createdAt)}`,
        tiles: [
          { label: 'Saved', value: c.saved, sub: `of ${total}`, alert: false },
          { label: 'Unfinished', value: c.failed + c.cancelled, sub: c.failed ? `${c.failed} failed` : c.cancelled ? `${c.cancelled} cancelled` : 'None', alert: c.failed > 0 },
          { label: 'Compiled', value: c.compiled, sub: c.compileFailed ? `${c.compileFailed} failed` : 'Octane OK', alert: c.compileFailed > 0 },
          { label: 'Converter', value: c.job.converter ? (c.job.converter.target === 'local' ? 'Local' : 'Remote') : '—', sub: c.job.converter ? host(c.job.converter.url) : 'Not recorded', alert: false },
        ],
      };
    }
    if (c.scan) {
      const ratio = c.eligibleCount ? c.selectedCount / c.eligibleCount : 0;
      return {
        eyebrow: 'Selected files', value: String(c.selectedCount), total: `/ ${c.eligibleCount}`, ring: ratio, ringLabel: `${Math.round(ratio * 100)}%`,
        tone: c.selectedCount ? 'green' : 'gray', pill: c.selectedCount ? 'Ready' : 'Nothing selected', caption: `${c.plannedOutputs} outputs · ${formatNames[c.formatMode]}`,
        tiles: [
          { label: 'TSX', value: c.tsxCount, sub: 'To convert', alert: false },
          { label: 'TypeScript', value: c.tsCount, sub: c.includeTs ? 'Copy as-is' : 'Excluded', alert: false },
          { label: 'Selected', value: c.selectedCount, sub: `of ${c.eligibleCount}`, alert: false },
          { label: 'Outputs', value: c.plannedOutputs, sub: formatNames[c.formatMode], alert: false },
        ],
      };
    }
    return {
      eyebrow: 'Workspace', value: '—', total: '', ring: 0, ringLabel: '—', tone: 'gray', pill: 'Idle', caption: 'Inspect a repository to begin',
      tiles: ['TSX', 'TypeScript', 'Selected', 'Outputs'].map(label => ({ label, value: '—', sub: 'Awaiting source', alert: false })),
    };
  }

  function converterState(c: Crawler) {
    const status = c.converterStatus;
    if (!status) return { tone: 'gray', label: 'Checking…' };
    if (status.ok) return { tone: 'green', label: `Online · ${status.latencyMs ?? 0} ms` };
    return { tone: 'red', label: status.latencyMs === undefined ? 'Offline' : 'Not the API' };
  }

component Card
  props { o, c }: { o: ReturnType<typeof overview>; c: Crawler }
  section.card.overview
    div.overview-top
      Ring(value={o.ring} tone={o.tone} label={o.ringLabel})
      div.score
        span.eyebrow #{o.eyebrow}
        div.score-value
          strong #{o.value}
          if o.total
            span #{o.total}
        div.score-caption
          span(className={'pill tone-' + o.tone}) #{o.pill}
          span.meta #{o.caption}
      div.overview-cta
        if c.running
          button.btn.btn-outline(type='button' onClick={() => c.cancel()})
            Icon(name='x' size={14})
            span Cancel run
        elseif c.job && (c.failed || c.cancelled)
          button.btn.btn-accent(type='button' disabled={c.busy} onClick={() => c.retry()})
            Icon(name='retry' size={14})
            span Retry unfinished
        elseif c.job
          button.btn.btn-outline(type='button' disabled={c.busy || !c.url.trim()} onClick={() => c.scan ? c.chooseFiles() : c.crawl()})
            Icon(name='scan' size={14})
            span #{c.scan ? 'Change selection' : 'Inspect again'}
        else
          button.btn.btn-accent(type='button' onClick={() => c.convert()} disabled={!c.scan || c.busy || !c.selectedCount || !c.config?.converterConfigured})
            Icon(name='convert' size={14})
            span Convert & save
    div.tiles
      each tile in o.tiles key tile.label
        div.tile
          span.eyebrow #{tile.label}
          strong #{tile.value}
          span(className={tile.alert ? 'meta tile-alert' : 'meta'} title={tile.sub}) #{tile.sub}

component Toolbar
  props { c }: { c: Crawler }
  div.toolbar
    label.search
      Icon(name='search' size={14})
      input(type='search' placeholder='Filter by path…' aria-label='Filter files' value={c.filter} onInput={(event) => c.setFilter(event.currentTarget.value)})
    if c.job
      if c.scan && !c.running && (c.failed || c.cancelled)
        button.link-button(type='button' disabled={c.busy} onClick={() => c.chooseFiles()}) Change selection
    else
      label.select-all-toggle
        input.sr-only(type='checkbox' ref={c.selectAllRef} checked={c.allSelected} disabled={c.busy || !c.eligibleCount} onChange={() => c.toggleAll()})
        span.check(aria-hidden='true')
          Icon(name='check' size={12})
        span Select all
        span.meta #{`${c.selectedCount} of ${c.eligibleCount}`}

component Card2
  props { c }: { c: Crawler }
  section.card.files
    div.card-head
      div.card-title
        h2 #{c.job ? 'Outputs' : 'Files'}
        if c.scan || c.job
          span.count-badge #{c.job ? c.job.files.length : c.fileCount}
      span.meta #{c.running ? 'Converting…' : !c.job && c.convertedCount ? `${c.convertedCount} already converted · hidden` : 'Sorted by path'}
    if c.scan || c.job
      fragment
        if c.segments.length
          fragment
            div.status-bar(aria-hidden='true')
              each segment in c.segments key segment.key
                span(className={'status-segment tone-' + segment.tone} style={{ flexGrow: segment.count }})
            div.chips
              each segment in c.segments key segment.key
                span.chip
                  span(className={'chip-dot tone-' + segment.tone})
                  span #{segment.label}
                  span.chip-count #{segment.count}
        Toolbar(c={c})
        if c.job?.error
          p.row-error.job-error(role='alert') #{c.job.error}
        FileList(c={c})
    else
      div.empty-state
        div.empty-art(aria-hidden='true')
          span.circle-icon.large
            Icon(name='code' size={20})
          span.empty-line
          span.circle-icon.large.accent
            Icon(name='convert' size={20})
          span.empty-line
          span.circle-icon.large
            Icon(name='folder' size={20})
        h3 Nothing inspected yet
        p Paste a repository or folder link to discover its TypeScript files and prepare your first conversion.
        div.chips
          span.chip Public GitHub repos
          span.chip Nested folders
          span.chip BTSX & TSRX

component Card3
  props { c }: { c: Crawler }
  section.card.preview
    div.card-head
      div.card-title
        span.circle-icon
          Icon(name='file' size={15})
        div.preview-title
          h2 Preview
          span.meta.plain #{c.preview?.path || (c.job ? 'Select a saved output' : 'Converted code appears here')}
      if c.preview
        div.preview-actions
          button.btn.btn-outline.btn-sm(type='button' onClick={() => c.copyCode()})
            Icon(name={c.copied ? 'check' : 'copy'} size={13})
            span #{c.copied ? 'Copied' : 'Copy'}
          a.btn.btn-outline.btn-sm(href={`/api/jobs/${c.job?.id}/output?path=${encodeURIComponent(c.preview.path)}&download=1`})
            Icon(name='download' size={13})
            span Download
    if c.previewLoading
      p.preview-placeholder Loading saved file…
    elseif c.previewError
      p.preview-placeholder.row-error(role='alert') #{c.previewError}
    elseif c.preview
      pre.code-preview
        code #{c.preview.code}
    else
      div.preview-placeholder
        code // Your next component starts here.

component Column2
  props { o, c }: { o: ReturnType<typeof overview>; c: Crawler }
  main.column
    Card(o={o} c={c})

    if c.scan || c.job
      section.card.tabs-card
        div.tabs(role='tablist' aria-label='Filter files')
          each tab in c.tabs key tab.key
            button(type='button' role='tab' aria-selected={c.view === tab.key} onClick={() => c.setView(tab.key)})
              span #{tab.label}
              span.tab-count #{tab.count}

    Card2(c={c})

    Card3(c={c})

component Frame
  props { c, endpoint, o }: { c: Crawler; endpoint: ConverterState; o: ReturnType<typeof overview> }
  div.frame
    div.tray
      TrayHeader(c={c} endpoint={endpoint})
        if c.error
          div.alert(role='alert')
            Icon(name='alert' )
            span #{c.error}

      div.tray-body
        Column(c={c} endpoint={endpoint})

        Column2(o={o} c={c})

      TrayFooter(c={c})

setup const c = useCrawler();
setup const o = overview(c);
setup const endpoint = converterState(c);

div.app-shell
  Frame(c={c} endpoint={endpoint} o={o})
