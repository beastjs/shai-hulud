module
  export type IconName = 'info' | 'cloud' | 'server' | 'code' | 'braces' | 'check' | 'plus' | 'download' | 'copy' | 'search' | 'x' | 'retry' | 'refresh' | 'branch' | 'folder' | 'file' | 'convert' | 'scan' | 'alert';

props { name, size = 16 }: { name: IconName; size?: number }

svg.icon(viewBox='0 0 24 24' width={size} height={size} aria-hidden='true' focusable='false')
  switch name
    case 'info'
      circle(cx='12' cy='12' r='9.5')
      path(d='M12 16v-4.5M12 8h.01')
    case 'cloud'
      path(d='M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z')
    case 'server'
      rect(x='3' y='3' width='18' height='7.5' rx='2')
      rect(x='3' y='13.5' width='18' height='7.5' rx='2')
      path(d='M7 6.75h.01M7 17.25h.01')
    case 'code'
      path(d='m16 18 6-6-6-6M8 6l-6 6 6 6')
    case 'braces'
      path(d='M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1')
    case 'check'
      path(d='M20 6 9 17l-5-5')
    case 'plus'
      path(d='M5 12h14M12 5v14')
    case 'download'
      path(d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3')
    case 'copy'
      rect(x='8' y='8' width='13' height='13' rx='2')
      path(d='M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2')
    case 'search'
      circle(cx='11' cy='11' r='7.5')
      path(d='m21 21-4.35-4.35')
    case 'x'
      path(d='M18 6 6 18M6 6l12 12')
    case 'retry'
      path(d='M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5')
    case 'refresh'
      path(d='M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5')
    case 'branch'
      circle(cx='6' cy='18' r='2.5')
      circle(cx='18' cy='6' r='2.5')
      path(d='M6 3v12.5M18 8.5a9 9 0 0 1-9 9')
    case 'folder'
      path(d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z')
    case 'file'
      path(d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z')
      path(d='M14 2v4a2 2 0 0 0 2 2h4')
    case 'convert'
      path(d='m16 3 4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16')
    case 'scan'
      path(d='M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10')
    case 'alert'
      circle(cx='12' cy='12' r='9.5')
      path(d='M12 8v4.5M12 16h.01')
