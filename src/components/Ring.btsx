props { value, tone, label }: { value: number; tone: string; label: string }

span(className={'gauge tone-' + tone})
  svg.gauge-svg(viewBox='0 0 100 100' aria-hidden='true' focusable='false')
    circle.gauge-track(cx='50' cy='50' r='43')
    if value > 0
      circle.gauge-value(cx='50' cy='50' r='43' pathLength='100' style={{ strokeDasharray: `${Math.min(value, 1) * 100} 100` }})
  span.gauge-label #{label}
