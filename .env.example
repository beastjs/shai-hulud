# The live converter is used by default; override only when needed.
CONVERTER_URL=https://playground.beastjs.workers.dev/api/converter
# Default for the UI's Local toggle: the converter Worker under `wrangler dev`.
# Must be on localhost, 127.0.0.1 or [::1]. The UI can override it per browser.
LOCAL_CONVERTER_URL=http://localhost:8787/api/converter
# Optional: raises GitHub's API rate limit. Never sent to the converter/browser.
GITHUB_TOKEN=
# Paths are relative to the project unless absolute.
OUTPUT_DIR=output
PORT=8788
